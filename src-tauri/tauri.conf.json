{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cheer Pressure",
  "version": "0.1.0",
  "identifier": "fi.junction.cheerpressure",
  "build": {
    "devUrl": "http://localhost:3470",
    "frontendDist": "../out",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Notices when your rhythm changes, compared only with yourself",
    "copyright": "MIT, the Cheer Pressure team",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
